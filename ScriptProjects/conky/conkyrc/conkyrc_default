${goto 2}${color DimGray}CPU15: ${goto 45}${if_match ${cpu cpu15} > 90}${color red}${else}$color${endif}${cpu cpu15}% ${goto 74}${color2}${cpubar cpu15 5, 72} ${goto 154}${color DimGray}CPU16: ${goto 197}${if_match ${cpu cpu16} > 90}${color red}${else}$color${endif}${cpu cpu16}% ${goto 226}${color2}${cpubar cpu16 5, 82}

#######################################################
# Memory  RAM
#######################################################
${font Arial:bold:size=10}${color1}RAM MEMORY ${color DarkSlateGray}${hr 2}
$font${color DimGray}MEM $alignc $mem / $memmax $alignr ${if_match $memperc >= 90}${color red}${else}${color white}${endif}$memperc%
${color2}$membar
${color DimGray}Swap: ${alignr}$swap / $swapmax - ${color white}$swapperc% ${alignr}${color2}${swapbar 5,120}

#######################################################
# Video
#######################################################
${font Arial:bold:size=10}${color1}VIDEO ${color DarkSlateGray}${hr 2}
$font${color DimGray}${execi 3600 ~/.conky/scripts/nvidia_stats.sh name} ${alignr}${color white}${execi 2 ~/.conky/scripts/nvidia_stats.sh util}% ${color2}${execbar 5,120 ~/.conky/scripts/nvidia_stats.sh util}
${color DimGray}Frequency: ${color white}${execi 2 ~/.conky/scripts/nvidia_stats.sh freq} MHz ${alignr}${color DimGray}Power: ${color white}${execi 2 ~/.conky/scripts/nvidia_stats.sh power} W
${color DimGray}Memory: ${color white}${execi 2 ~/.conky/scripts/nvidia_stats.sh mem}% ${alignr}${color DimGray}VRAM: ${color white}${execi 2 ~/.conky/scripts/nvidia_stats.sh mem_used} / ${execi 3600 ~/.conky/scripts/nvidia_stats.sh mem_total} MB
