#######################################################
${voffset -30}
${color DimGray}
${font Arial:bold:size=10}${color1}SYSTEM ${color DarkSlateGray} ${hr 2}
$font${color DimGray}Device Name $alignr${color white}$nodename
${color DimGray}$sysname $kernel $alignr${color white}$machine
${color DimGray}${execi 1000 cat /proc/cpuinfo | grep 'model name' | sed -e 's/model name.*: //'| uniq | cut -c 1-26} $alignr${color white}${freq_g cpu0}Ghz
${color DimGray}Uptime $alignr${color white}${uptime}

