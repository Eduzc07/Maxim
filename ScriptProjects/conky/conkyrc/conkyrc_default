conky.config = {
    background = true,
    update_interval = 2,

    use_xft = true,
    font = '123:size=9',
    xftalpha = 0.1,

    double_buffer = true,
    no_buffers = true,

    override_utf8_locale = true,
    text_buffer_size = 256,

    total_run_times = 0,

    draw_shades = false,
    draw_outline = false,
    draw_borders = false,
    draw_graph_borders = false,
    default_color = 'gray',
    default_shade_color = 'red',
    default_outline_color = 'green',

    uppercase = false,
    cpu_avg_samples = 2,
    net_avg_samples = 1,

    use_spacer = 'right',

    -- Window settings
    own_window = true,
    own_window_class = 'Conky',
    own_window_type = 'normal',
    own_window_transparent = false,
    own_window_argb_visual = true,
    own_window_argb_value = 200,
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',

    -- Position settings
    alignment = 'top_right',
    gap_x = 5,
    gap_y = 10,
    minimum_width = 310,
    minimum_height = 500,
    maximum_width = 310,

    -- Colors
    color1 = '#06BA07',
    color2 = '#1081E0',
};

conky.text = [[
