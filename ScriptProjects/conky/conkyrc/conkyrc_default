${goto 2}${color DimGray}CPU 9: ${goto 45}${if_match ${cpu cpu9} > 90}${color red}${else}$color${endif}${cpu cpu9}% ${goto 74}${color2}${cpubar cpu9 5, 72} ${goto 154}${color DimGray}CPU10: ${goto 197}${if_match ${cpu cpu10} > 90}${color red}${else}$color${endif}${cpu cpu10}% ${goto 226}${color2}${cpubar cpu10 5, 82}
${goto 2}${color DimGray}CPU11: ${goto 45}${if_match ${cpu cpu11} > 90}${color red}${else}$color${endif}${cpu cpu11}% ${goto 74}${color2}${cpubar cpu11 5, 72} ${goto 154}${color DimGray}CPU12: ${goto 197}${if_match ${cpu cpu12} > 90}${color red}${else}$color${endif}${cpu cpu12}% ${goto 226}${color2}${cpubar cpu12 5, 82}
