$font${color DimGray}/home $alignc ${fs_used /home} / ${fs_size /home} $alignr${if_match ${fs_used_perc /home} >= 90}${color red}${else}${color white}${endif}${fs_used_perc /home}%
${color2}${fs_bar /home}

