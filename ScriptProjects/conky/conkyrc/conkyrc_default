${color white}${font}Name ${alignr}PID               CPU%           MEM%
${color DimGray}$font${top_mem name 1}${alignr}${top_mem pid 1}          ${top_mem cpu 1}%         ${top_mem mem 1}%
$font${top_mem name 2}${alignr}${top_mem pid 2}          ${top_mem cpu 2}%         ${top_mem mem 2}%
$font${top_mem name 3}${alignr}${top_mem pid 3}          ${top_mem cpu 3}%         ${top_mem mem 3}%
$font${top_mem name 4}${alignr}${top_mem pid 4}          ${top_mem cpu 4}%         ${top_mem mem 4}%

#######################################################
# Network
#######################################################
${font Arial:bold:size=10}${color1}NETWORK ${color DarkSlateGray}${hr 2}
$font${color DimGray}External IP  $alignr ${color white}${execi 1000 wget -q -O- https://api.ipify.org?format=plain; echo;}
${if_existing /sys/class/net/enp6s0/carrier 1}$font${color DimGray}Local IP (ETH) $alignr ${color white}${addr enp6s0}
